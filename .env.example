# Copie para .env (que o .gitignore ja ignora) e preencha com os SEUS valores.
# Este arquivo e so o modelo: nunca coloque valores reais aqui.

# Chave do provedor de IA em uso (ia.provedor no application.properties).
GEMINI_API_KEY=

# Provedores alternativos, se trocar ia.provedor.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Porta. Em producao a plataforma injeta automaticamente; local usa 8081.
PORT=

# Console do H2 e log de SQL: "true" em desenvolvimento, "false" em producao.
H2_CONSOLE=
SHOW_SQL=

# Somente se rodar com o profile mysql (--spring.profiles.active=mysql).
MYSQL_USER=
MYSQL_PASSWORD=
